<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <!-- Kanalın resmi YouTube canlı yayını (yalnızca yedek olarak kullanılır) -->
    <WebView
        android:id="@+id/ytView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone" />

    <!-- Radyo çalarken arkada dönen şömine videosu (sessiz) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/bgVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:show_buffering="never"
        app:use_controller="false" />

    <!-- Yazılar alevlerin üstünde okunsun diye hafif karartma -->
    <View
        android:id="@+id/fireScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <!-- Lisans gereği video kaynağı -->
    <TextView
        android:id="@+id/fireCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:alpha="0.5"
        android:text="Şömine videosu: Larvis, CC BY-SA 4.0, Wikimedia Commons"
        android:textColor="@color/text"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Radyo çalarken arkada akan canlı doğa manzarası -->
    <com.tvkanal.app.NatureView
        android:id="@+id/natureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Radyo çalarken ekranda görünen kart -->
    <LinearLayout
        android:id="@+id/radioCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@null"
            android:src="@drawable/radio_logo" />
        <TextView
            android:id="@+id/radioName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text"
            android:textSize="44sp"
            android:shadowColor="#AA000000"
            android:shadowRadius="12"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.15"
            android:text="RADYO · CANLI"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Köşedeki küçük Alin's logosu -->
    <ImageView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:adjustViewBounds="true"
        android:alpha="0.38"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:src="@drawable/watermark" />

    <!-- Kanal adı bilgi şeridi -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="40dp"
        android:background="@drawable/banner_bg"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/infoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Hata / durum mesajı -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/banner_bg"
        android:padding="20dp"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:visibility="gone" />

    <!-- Görüntü kalitesi menüsü (sağ tuş) -->
    <LinearLayout
        android:id="@+id/qualityPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="14dp"
            android:text="Görüntü kalitesi"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/qualityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Kanal listesi paneli -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <!-- Kategori sütunu kaldırıldı: yalnızca tek kanal listesi gösterilir -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="400dp"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>
</FrameLayout>
