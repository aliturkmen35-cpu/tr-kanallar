<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <!-- Radyo çalarken ekranda görünen kart -->
    <LinearLayout
        android:id="@+id/radioCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />
        <TextView
            android:id="@+id/radioName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/text"
            android:textSize="44sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.15"
            android:text="RADYO · CANLI"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Köşedeki küçük Alin's logosu -->
    <ImageView
        android:id="@+id/watermark"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="36dp"
        android:adjustViewBounds="true"
        android:alpha="0.45"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:src="@drawable/watermark" />

    <!-- Kanal adı bilgi şeridi -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="40dp"
        android:background="@drawable/banner_bg"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/infoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- Hata / durum mesajı -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/banner_bg"
        android:padding="20dp"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:visibility="gone" />

    <!-- Görüntü kalitesi menüsü (sağ tuş) -->
    <LinearLayout
        android:id="@+id/qualityPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/panel"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:paddingHorizontal="14dp"
            android:text="Görüntü kalitesi"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/qualityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Kanal listesi paneli -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/panel"
        android:orientation="horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryList"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="8dp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="24dp" />
    </LinearLayout>
</FrameLayout>
